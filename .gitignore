# ==============================================================================
# PAYPAL SUBWISE AI - ROOT .GITIGNORE
# Security hardening: Prevent credential leakage, secrets & build artifacts
# ==============================================================================

# Environment files & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Database files
*.sqlite3
*.db
*.bak

# Node.js & Frontend
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Temporary files & Windows batch artifacts
tmp/
temp/
*.log

