# ==============================================================================
# PAYPAL SUBWISE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure credentials for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string:
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:<YOUR_SECURE_PASSWORD>@localhost:5432/subwise_ai

# Alternatively, configure discrete connection parameters:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_SECURE_PASSWORD>
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=subwise_ai

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# A secure, random 32+ character secret string for HMAC-SHA256 JWT signing
SECRET_KEY=subwise_ai_production_super_secret_jwt_key_2026_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. PAYPAL REST API CREDENTIALS (Developer Sandbox)
# ------------------------------------------------------------------------------
# Options: 'sandbox' (testing) or 'live' (production)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE & LLM ADVISOR
# ------------------------------------------------------------------------------
# Google Gemini API key for contextual CFO briefing generation
GEMINI_API_KEY=
LLM_API_KEY=

